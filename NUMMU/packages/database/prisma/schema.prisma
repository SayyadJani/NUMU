// This is your Prisma schema file.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  STUDENT
  TRAINER
  COLLEGE_ADMIN
  PLATFORM_ADMIN
}

enum OrganizationRole {
  OWNER
  ADMIN
  TRAINER
  MEMBER
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TestAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum SubmissionStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum SubmissionVerdict {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  COMPILATION_ERROR
  RUNTIME_ERROR
  INTERNAL_ERROR
}

enum ExecutionMode {
  FUNCTION
  STDIN_STDOUT
}

// ─────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  username            String?              @unique
  name                String?
  passwordHash        String?              @map("password_hash")
  role                Role                 @default(STUDENT)
  isActive            Boolean              @default(true) @map("is_active")
  isEmailVerified     Boolean              @default(false) @map("is_email_verified")
  profile             Profile?
  sessions            Session[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  organizationMembers OrganizationMember[]
  authoredProblems    Problem[]
  authoredTests       Test[]               @relation("AuthoredTests")
  submissions         Submission[]
  testAttempts        TestAttempt[]
  xpTransactions      XpTransaction[]
  userBadges          UserBadge[]
  notes               Note[]
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio         String?
  headline    String?
  avatarUrl   String?  @map("avatar_url")
  college     String?
  gradYear    Int?     @map("grad_year")
  githubUrl   String?  @map("github_url")
  linkedinUrl String?  @map("linkedin_url")
  websiteUrl  String?  @map("website_url")
  location    String?
  skills      String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

model Session {
  id             String         @id @default(cuid())
  userId         String         @map("user_id")
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent      String?        @map("user_agent")
  ipAddress      String?        @map("ip_address")
  isRevoked      Boolean        @default(false) @map("is_revoked")
  revokedAt      DateTime?      @map("revoked_at")
  lastActivityAt DateTime       @default(now()) @map("last_activity_at")
  expiresAt      DateTime       @map("expires_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  refreshTokens  RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
  @@index([isRevoked])
  @@map("sessions")
}

model RefreshToken {
  id                  String   @id @default(cuid())
  userId              String   @map("user_id")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId           String?  @map("session_id")
  session             Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash           String   @unique @map("token_hash")
  family              String   @default(cuid())
  isRevoked           Boolean  @default(false) @map("is_revoked")
  replacedByTokenHash String?  @map("replaced_by_token_hash")
  expiresAt           DateTime @map("expires_at")
  userAgent           String?  @map("user_agent")
  ipAddress           String?  @map("ip_address")
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
  @@index([family])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Organization {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  description String?
  logoUrl     String?              @map("logo_url")
  members     OrganizationMember[]
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String           @map("user_id")
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_members")
}

model Topic {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  icon        String?
  order       Int            @default(0)
  problems    ProblemTopic[]
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([order])
  @@map("topics")
}

model Problem {
  id             String           @id @default(cuid())
  slug           String           @unique
  title          String
  difficulty     Difficulty       @default(EASY)
  status         ContentStatus    @default(DRAFT)
  description    String           @db.Text
  constraints    String[]         @default([])
  hints          String[]         @default([])
  editorial      String?          @db.Text
  boilerplate    Json             @default("{}")
  executionMode  ExecutionMode    @default(FUNCTION) @map("execution_mode")
  functionContract Json?          @map("function_contract")
  inputFormat    String?          @map("input_format") @db.Text
  outputFormat   String?          @map("output_format") @db.Text
  comparatorType String           @default("EXACT") @map("comparator_type")
  acceptanceRate Float            @default(0.0) @map("acceptance_rate")
  authorId       String           @map("author_id")
  author         User             @relation(fields: [authorId], references: [id], onDelete: Restrict)
  topics         ProblemTopic[]
  examples       ProblemExample[]
  testCases      ProblemTestCase[]
  solutions      ProblemSolution[]
  submissions    Submission[]
  testAssignments TestQuestionAssignment[]
  testAnswers    TestAnswer[]
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([status, difficulty])
  @@index([status, createdAt])
  @@index([authorId])
  @@map("problems")
}

model ProblemTopic {
  problemId String  @map("problem_id")
  topicId   String  @map("topic_id")
  isPrimary Boolean @default(false) @map("is_primary")
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  topic     Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([problemId, topicId])
  @@index([topicId, problemId])
  @@map("problem_topics")
}

model ProblemExample {
  id          String   @id @default(cuid())
  problemId   String   @map("problem_id")
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input       String   @db.Text
  output      String   @db.Text
  explanation String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([problemId, order])
  @@map("problem_examples")
}

model Submission {
  id           String            @id @default(cuid())
  problemId    String            @map("problem_id")
  problem      Problem           @relation(fields: [problemId], references: [id], onDelete: Cascade)
  userId       String            @map("user_id")
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  language     String            @map("language")
  code         String            @db.Text
  status       SubmissionStatus  @default(QUEUED)
  verdict      SubmissionVerdict @default(PENDING)
  runtimeMs    Int?              @map("runtime_ms")
  memoryKb     Int?              @map("memory_kb")
  testsPassed  Int               @default(0) @map("tests_passed")
  totalTests   Int               @default(0) @map("total_tests")
  compileError String?           @map("compile_error") @db.Text
  stdout       String?           @db.Text
  stderr       String?           @db.Text
  judge0Tokens String[]          @default([]) @map("judge0_tokens")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@index([userId, problemId, createdAt(sort: Desc)])
  @@index([problemId, verdict])
  @@index([status])
  @@index([userId, verdict])
  @@index([userId, createdAt])
  @@map("submissions")
}

model ProblemTestCase {
  id             String   @id @default(cuid())
  problemId      String   @map("problem_id")
  problem        Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input          String   @db.Text
  expectedOutput String   @map("expected_output") @db.Text
  isHidden       Boolean  @default(true) @map("is_hidden")
  orderIndex     Int      @default(0) @map("order_index")
  timeLimitMs    Int      @default(2000) @map("time_limit_ms")
  memoryLimitKb  Int      @default(262144) @map("memory_limit_kb")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([problemId, isHidden, orderIndex])
  @@map("problem_test_cases")
}

model ProblemSolution {
  id              String   @id @default(cuid())
  problemId       String   @map("problem_id")
  problem         Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  language        String   @map("language")
  code            String   @db.Text
  title           String?
  explanation     String?  @db.Text
  timeComplexity  String?  @map("time_complexity")
  spaceComplexity String?  @map("space_complexity")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([problemId, language])
  @@index([problemId])
  @@map("problem_solutions")
}

model XpTransaction {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Int
  eventType      String   @map("event_type")
  sourceType     String   @map("source_type")
  sourceId       String   @map("source_id")
  idempotencyKey String   @unique @map("idempotency_key")
  policyVersion  String   @default("1.0") @map("policy_version")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([userId, sourceType, sourceId, eventType])
  @@index([userId, createdAt])
  @@map("xp_transactions")
}

model BadgeDefinition {
  id                String      @id @default(cuid())
  slug              String      @unique
  name              String
  description       String
  icon              String
  category          String      @default("Milestone")
  rarity            String      @default("Common")
  criteriaType      String      @map("criteria_type")
  criteriaThreshold Int         @map("criteria_threshold")
  isActive          Boolean     @default(true) @map("is_active")
  createdAt         DateTime    @default(now()) @map("created_at")
  userBadges        UserBadge[]

  @@map("badge_definitions")
}

model UserBadge {
  id        String          @id @default(cuid())
  userId    String          @map("user_id")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String          @map("badge_id")
  badge     BadgeDefinition @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime        @default(now()) @map("awarded_at")

  @@unique([userId, badgeId])
  @@index([userId, awardedAt])
  @@map("user_badges")
}

model Test {
  id              String                   @id @default(cuid())
  slug            String                   @unique
  title           String
  description     String?                  @db.Text
  weekNumber      Int?                     @map("week_number")
  instructions    String?                  @db.Text
  durationMinutes Int                      @default(90) @map("duration_minutes")
  passPercentage  Int                      @default(60) @map("pass_percentage")
  totalMarks      Int                      @default(100) @map("total_marks")
  status          ContentStatus            @default(DRAFT)
  startTime       DateTime?                @map("start_time")
  endTime         DateTime?                @map("end_time")
  authorId        String?                  @map("author_id")
  author          User?                    @relation("AuthoredTests", fields: [authorId], references: [id], onDelete: SetNull)
  questions       TestQuestionAssignment[]
  attempts        TestAttempt[]
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  @@index([status, startTime, endTime])
  @@map("tests")
}

model TestQuestionAssignment {
  id         String   @id @default(cuid())
  testId     String   @map("test_id")
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  problemId  String   @map("problem_id")
  problem    Problem  @relation(fields: [problemId], references: [id], onDelete: Restrict)
  orderIndex Int      @default(0) @map("order_index")
  marks      Int      @default(20)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([testId, problemId])
  @@unique([testId, orderIndex])
  @@map("test_question_assignments")
}

model TestAttempt {
  id              String            @id @default(cuid())
  testId          String            @map("test_id")
  test            Test              @relation(fields: [testId], references: [id], onDelete: Cascade)
  userId          String            @map("user_id")
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt       DateTime          @default(now()) @map("started_at")
  expiresAt       DateTime          @map("expires_at")
  submittedAt     DateTime?         @map("submitted_at")
  status          TestAttemptStatus @default(IN_PROGRESS)
  score           Int               @default(0)
  percentage      Float             @default(0.0)
  passed          Boolean           @default(false)
  currentQuestion Int               @default(0) @map("current_question")
  answers         TestAnswer[]
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@unique([testId, userId])
  @@index([userId, status])
  @@map("test_attempts")
}

model TestAnswer {
  id                String             @id @default(cuid())
  attemptId         String             @map("attempt_id")
  attempt           TestAttempt        @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  problemId         String             @map("problem_id")
  problem           Problem            @relation(fields: [problemId], references: [id], onDelete: Cascade)
  code              String             @db.Text
  language          String             @default("python")
  isMarkedForReview Boolean            @default(false) @map("is_marked_for_review")
  isSubmitted       Boolean            @default(false) @map("is_submitted")
  status            String             @default("unanswered")
  verdict           SubmissionVerdict?
  testsPassed       Int                @default(0) @map("tests_passed")
  totalTests        Int                @default(0) @map("total_tests")
  marksAwarded      Int                @default(0) @map("marks_awarded")
  timeSpentSeconds  Int                @default(0) @map("time_spent_seconds")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@unique([attemptId, problemId])
  @@map("test_answers")
}

model Note {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  content       String    @db.Text
  category      String    @default("dsa")
  tags          String[]  @default([])
  isPinned      Boolean   @default(false) @map("is_pinned")
  color         String    @default("emerald")
  linkedProblem Json?     @map("linked_problem")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, isPinned])
  @@map("notes")
}

