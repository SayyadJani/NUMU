{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@numu/config-typescript/tsconfig.nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "noEmit": true,
    "isolatedModules": true
  },
  "include": [
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next-prod /types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
