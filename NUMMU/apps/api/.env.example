# Server Configuration
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://numu_user:numu_dev_password@localhost:5432/numu_db?schema=public"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"

# JWT & Authentication
JWT_ACCESS_SECRET="replace_with_a_secure_random_key_min_32_characters_in_production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_DAYS=7

# Cookie Settings
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Execution Engine Configuration
EXECUTION_PROVIDER=judge0
JUDGE0_BASE_URL=http://127.0.0.1:2358
JUDGE0_AUTH_TOKEN=
JUDGE0_TIMEOUT_MS=5000
JUDGE0_POLL_INTERVAL_MS=500
JUDGE0_MAX_POLL_ATTEMPTS=60
